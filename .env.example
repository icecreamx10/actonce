# Recommended free baseline. Create an API key in Google AI Studio, copy this
# file to .env, and replace the placeholder. Never commit the real key.
MIDSCENE_MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
MIDSCENE_MODEL_API_KEY=replace-with-your-google-ai-studio-key
MIDSCENE_MODEL_NAME=gemini-3.5-flash
MIDSCENE_MODEL_FAMILY=gemini
