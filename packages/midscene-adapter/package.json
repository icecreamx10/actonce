{
  "name": "@byted-lynx/actonce-midscene-adapter",
  "version": "0.2.0",
  "description": "The only ActOnce package allowed to depend on Midscene.",
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": { "registry": "http://bnpm.byted.org" },
  "engines": { "node": "^20.19.0 || ^22.12.0 || >=24.0.0" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./web": { "types": "./dist/web.d.ts", "import": "./dist/web.js" }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "npm run clean && npm run build",
    "model:verify": "npx @midscene/cli@1.10.10 model verify",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@midscene/android": "1.10.10",
    "@midscene/computer": "1.10.10",
    "@midscene/ios": "1.10.10",
    "@midscene/web": "1.10.10"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "7.0.2"
  }
}
