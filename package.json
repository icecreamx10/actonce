{
  "name": "actonce",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Record AI device actions once, replay them deterministically.",
  "scripts": {
    "android:bootstrap": "bash scripts/android/bootstrap-sdk.sh",
    "android:start": "bash scripts/android/start-emulator.sh",
    "android:start:foreground": "bash scripts/android/start-emulator.sh --foreground",
    "android:start:headed": "bash scripts/android/start-emulator.sh --headed",
    "android:start:headed:foreground": "bash scripts/android/start-emulator.sh --headed --foreground",
    "android:stop": "bash scripts/android/stop-emulator.sh",
    "android:install:markor": "bash scripts/android/install-markor.sh",
    "android:prepare:markor": "bash scripts/android/run-android-ts.sh benchmark/android/markor-fixture.ts",
    "ios:start": "bash scripts/ios/start-simulator.sh",
    "ios:wda": "bash scripts/ios/start-wda.sh",
    "ios:wda:stop": "bash scripts/ios/stop-wda.sh",
    "ios:wda:smoke": "tsx benchmark/ios/wda-smoke.ts",
    "interceptor:start": "tsx interceptor/src/cli.ts",
    "interceptor:ios": "tsx interceptor/src/ios/wda-proxy.ts",
    "interceptor:macos:smoke": "tsx interceptor/src/macos/smoke.ts",
    "interceptor:annotate": "tsx interceptor/src/annotate-recording.ts",
    "benchmark:fixture": "tsx benchmark/fixture/server.ts",
    "benchmark:android:markor": "bash scripts/android/run-android-ts.sh benchmark/android/midscene-markor.ts",
    "benchmark:android:midscene": "bash scripts/android/run-midscene-benchmark.sh",
    "benchmark:android:smoke": "bash scripts/android/run-midscene-smoke.sh",
    "benchmark:ios:smoke": "tsx benchmark/ios/midscene-settings-smoke.ts",
    "benchmark:midscene": "tsx benchmark/midscene-baseline.ts",
    "model:verify": "npx @midscene/cli@1.10.10 model verify",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@midscene/android": "1.10.10",
    "@midscene/computer": "1.10.10",
    "@midscene/ios": "1.10.10",
    "@midscene/web": "1.10.10",
    "dotenv": "^17.2.3",
    "playwright": "1.62.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "appium-webdriveragent": "^16.1.6",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
