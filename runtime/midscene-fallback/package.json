{
  "name": "@byted-lynx/actonce-midscene-fallback",
  "version": "0.0.0",
  "description": "Bounded Midscene fallback adapter for ActOnce replay flows.",
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": { "registry": "http://bnpm.byted.org" },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run clean && npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@byted-lynx/actonce-replay": "^0.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
